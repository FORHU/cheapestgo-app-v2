# ── API ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v2
NEXT_PUBLIC_SITE_URL=http://localhost:4000

# The hostname staff work from (app-v2 ADR-0006). Leave unset until the proxy actually
# routes it: with it set, /admin 404s on every other host, so configuring it early makes
# the back office unreachable from everywhere. Set, /admin answers only here and this host
# serves nothing else.
# NEXT_PUBLIC_STAFF_HOST=admin.cheapestgo.com

# ── Maps ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_MAPBOX_TOKEN=

# ── Payments ─────────────────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# ── Analytics / Monitoring ───────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=

# ── SEO ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ── Brand ────────────────────────────────────────────────────────────
# Which brand this build is: CheapestGo (default) or AirangGo. Compiled into the client
# bundle, so it is a *build* setting — one deployment per brand (v1 ADR-0005). GeomeeGo is
# still accepted and reads as AirangGo until the Korean instance is rebuilt.
NEXT_PUBLIC_BRAND_NAME=CheapestGo

# Lets a visitor to this deployment switch between CheapestGo and AirangGo, so one unfinished
# deployment can show both (docs/adr/0005-brand-preview-on-non-production-deployments.md).
# Display-only. Leave it UNSET on production — with it unset, `?brand_preview=` and the cookie
# are ignored and no switcher is rendered. A local `next dev` has it on without this variable.
# Vercel: add it to the Preview environment only, never Production.
BRAND_PREVIEW=
